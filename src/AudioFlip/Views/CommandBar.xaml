<UserControl
    x:Class="AudioFlip.CommandBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{x:Bind Label, Mode=OneWay}"
                   Visibility="{x:Bind GetLabelVisibility(Label), Mode=OneWay}" />
        <TextBox Grid.Column="1"
                 IsReadOnly="True"
                 Text="{x:Bind CommandText, Mode=OneWay}"
                 ToolTipService.ToolTip="{x:Bind CommandText, Mode=OneWay}"
                 AutomationProperties.Name="Command line" />
        <Button Grid.Column="2"
                Background="Transparent"
                Command="{x:Bind CopyCommand, Mode=OneWay}"
                ToolTipService.ToolTip="Copy command to clipboard"
                AutomationProperties.Name="Copy command to clipboard">
            <SymbolIcon Symbol="Copy" />
        </Button>
    </Grid>
</UserControl>
